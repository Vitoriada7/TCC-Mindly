{
  "name": "tcc-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/configure-api.mjs && ng serve",
    "build": "node scripts/configure-api.mjs --production && ng build",
    "watch": "node scripts/configure-api.mjs && ng build --watch --configuration development",
    "test": "node scripts/configure-api.mjs && node --test scripts/configure-api.test.mjs && ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.3",
    "@angular/cli": "^21.1.3",
    "@angular/compiler-cli": "^21.1.0",
    "@types/leaflet": "^1.9.21",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
